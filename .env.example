# Copy this file to .env.local (which git ignores) and fill it in there. Never put a real key in this file.
# Used only by scripts/art/generate.mjs, on your machine; the game never reads these (Vite only exposes VITE_ names).

# BytePlus ModelArk API key (console: API Key Management).
ARK_API_KEY=
# The image model to call: a Seedream model ID or an endpoint ID (ep-...) from the ModelArk console.
ARK_IMAGE_MODEL=
# The ModelArk API base for your region.
ARK_BASE_URL=https://ark.ap-southeast.bytepluses.com/api/v3
