# Copy this file to .env.local (which git ignores) and fill it in there. Never put a real key in this file.
# Used only by the art scripts in scripts/art/, on your machine; the game never reads these (Vite only exposes VITE_ names).

# BytePlus ModelArk API key (console: API Key Management).
ARK_API_KEY=
# The image model to call (scripts/art/generate.mjs): a Seedream model ID or an endpoint ID (ep-...) from the ModelArk console.
ARK_IMAGE_MODEL=
# The video model to call: a Seedance model ID or an endpoint ID (ep-...) from the ModelArk console.
# Video jobs run as tasks on the same base URL (contents/generations/tasks), with the same key.
ARK_VIDEO_MODEL=
# The ModelArk API base for your region.
ARK_BASE_URL=https://ark.ap-southeast.bytepluses.com/api/v3
